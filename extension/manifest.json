{
  "manifest_version": 3,
  "name": "Maps Tab for Qwant",
  "version": "1.0.0",
  "description": "Adds a Maps tab to Qwant search results that opens your query in your chosen map service.",
  "author": "Szymon Zborowski",
  "homepage_url": "https://github.com/ZoltePudeleczko/maps-for-qwant-extension",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.qwant.com/*",
        "https://qwant.com/*"
      ],
      "js": [
        "providers.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Maps Tab for Qwant – settings",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
